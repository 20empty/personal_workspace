{
  "$schema": "https://tauri.app/schemas/v2.json",
  "productName": "Classroom",
  "version": "0.0.1",
  "identifier": "com.classroom.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Classroom",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:/Users/jerry/codex/personal workspace/src-tauri/classroom.db"
      ]
    }
  }
}
